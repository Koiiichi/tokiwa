table inet cloud_workspace {
 chain output {
  type filter hook output priority -100; policy accept;
  # Sessions run as agent-workspace (2100). They never reach the instance metadata service,
  # so they cannot read the credentials of the instance role.
  meta skuid { 2100, 2101 } ip daddr 169.254.169.254 reject
  meta skuid { 2100, 2101 } ip6 daddr fd00:ec2::254 reject
 }
}

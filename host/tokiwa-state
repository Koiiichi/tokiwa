#!/usr/bin/python3 -I
"""Record what the agent in this tmux pane reports through a hook, as options of its tmux session.

Usage: tokiwa-state STATE [--turn] [--kind question|permission]

Agents call this command from their hooks, so it never fails: a hook that fails can stop an agent.
Every error ends in exit status 0. The hook settings decide which event means which state; this
command only records it. The hook event arrives as JSON on stdin.

Options that it sets on the session:
  @tokiwa_agent          STATE:EPOCH. The time is when the state began. `note` never changes it.
  @tokiwa_turn           The number of turns, counted by --turn.
  @tokiwa_transcript     The transcript path from the event.
  @tokiwa_agent_session  The session id of the agent from the event.
  @tokiwa_pending        Base64 JSON of the question or permission request that waits for a person.
  @tokiwa_last_tool      Base64 JSON of the last tool call that a `note` event reported.
"""

import base64
import hashlib
import json
import os
import subprocess
import sys
import time

STATES = ("working", "waiting", "idle", "limited", "error", "ended", "note")
KINDS = ("question", "permission")
# States in which no question or permission request waits any longer.
CLEARS_PENDING = ("working", "idle", "ended")
MAX_INPUT = 65536
MAX_SUMMARY = 500
TMUX_TIMEOUT = 2


def read_input():
    """Return up to MAX_INPUT bytes of stdin, and read the rest so the hook never waits on a full pipe."""
    try:
        fd = sys.stdin.fileno()
        data = b""
        while True:
            chunk = os.read(fd, 65536)
            if not chunk:
                return data
            data += chunk[: max(0, MAX_INPUT - len(data))]
    except (OSError, ValueError):
        return b""


def parse(raw):
    """Return the event as a dict, or an empty dict when the input is not a JSON object."""
    try:
        event = json.loads(raw)
    except ValueError:
        return {}
    return event if isinstance(event, dict) else {}


def text(value):
    return value if isinstance(value, str) else ""


def encode(item):
    return base64.b64encode(json.dumps(item, separators=(",", ":")).encode()).decode()


def tool_detail(tool_input):
    """The part of a tool input that a person needs to recognize the call."""
    if not isinstance(tool_input, dict):
        return ""
    for key in ("command", "file_path", "path", "url", "pattern", "description"):
        if isinstance(tool_input.get(key), str) and tool_input[key]:
            return tool_input[key]
    return ""


def tool_summary(event):
    """`TOOL: DETAIL` for the tool of the event, or an empty string."""
    tool = text(event.get("tool_name"))
    if not tool:
        return ""
    detail = tool_detail(event.get("tool_input"))
    return f"{tool}: {detail}" if detail else tool


def questions_of(event):
    """The first question of an AskUserQuestion call, as (text, option labels)."""
    tool_input = event.get("tool_input")
    questions = tool_input.get("questions") if isinstance(tool_input, dict) else None
    first = questions[0] if isinstance(questions, list) and questions else None
    if not isinstance(first, dict):
        return "", []
    options = first.get("options") if isinstance(first.get("options"), list) else []
    return text(first.get("question")), [text(o.get("label")) for o in options if isinstance(o, dict)]


def pending_item(event, raw, kind, last_tool):
    """The question or permission request that the event reports."""
    if event.get("mode") == "url" or event.get("notification_type") == "elicitation_url_dialog":
        kind = "permission"
    options = []
    if event.get("tool_name") == "AskUserQuestion":
        summary, options = questions_of(event)
    elif event.get("tool_name"):
        summary = tool_summary(event)
    elif kind == "permission" and last_tool and event.get("notification_type") == "permission_prompt":
        summary = f"{last_tool.get('tool', '')}: {last_tool.get('summary', '')}".rstrip(": ")
    else:
        summary = text(event.get("message"))
    if text(event.get("url")):
        summary = f"{summary} {event['url']}".strip()
    identity = text(event.get("tool_use_id")) or hashlib.sha256(raw).hexdigest()[:16]
    return {"id": identity, "kind": kind, "summary": summary[:MAX_SUMMARY], "options": options,
            "at": int(time.time())}


def tmux(*args):
    """Run tmux against the server of this session; -N never starts a server."""
    return subprocess.run(["tmux", "-N", *args], capture_output=True, text=True, timeout=TMUX_TIMEOUT)


def option(pane, name):
    return tmux("show-options", "-qv", "-t", pane, name).stdout.strip()


def record(argv):
    state = argv[0] if argv else ""
    flags = argv[1:]
    raw = read_input()
    pane = os.environ.get("TMUX_PANE", "")
    if state not in STATES or not pane or not os.environ.get("TMUX"):
        return
    kind = flags[flags.index("--kind") + 1] if "--kind" in flags and flags.index("--kind") + 1 < len(flags) else ""
    event = parse(raw)

    def put(name, value):
        tmux("set-option", "-q", "-t", pane, name, value)

    if state == "ended":
        tmux("set-option", "-qu", "-t", pane, "@tokiwa_agent")
    elif state != "note" and option(pane, "@tokiwa_agent").partition(":")[0] != state:
        # The time is when the state began: a report of the state that is already there keeps it.
        put("@tokiwa_agent", f"{state}:{int(time.time())}")
    if "--turn" in flags:
        turn = option(pane, "@tokiwa_turn")
        put("@tokiwa_turn", str(int(turn) + 1 if turn.isdigit() else 1))
    for name, key in (("@tokiwa_transcript", "transcript_path"), ("@tokiwa_agent_session", "session_id")):
        if text(event.get(key)):
            put(name, event[key])
    if state == "note" and event.get("tool_name"):
        last = {"tool": text(event["tool_name"]), "summary": tool_detail(event.get("tool_input"))[:MAX_SUMMARY],
                "at": int(time.time())}
        put("@tokiwa_last_tool", encode(last))
    if state in CLEARS_PENDING:
        tmux("set-option", "-qu", "-t", pane, "@tokiwa_pending")
    elif state == "waiting" and kind in KINDS:
        last_tool = {}
        try:
            last_tool = json.loads(base64.b64decode(option(pane, "@tokiwa_last_tool")))
        except ValueError:
            pass
        if not isinstance(last_tool, dict):
            last_tool = {}
        put("@tokiwa_pending", encode(pending_item(event, raw, kind, last_tool)))


def main(argv):
    try:
        record(argv)
    except Exception:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

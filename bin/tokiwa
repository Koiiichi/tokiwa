  # "failed to run commands: exit status N" after it when the script exits non-zero.
  refusal=$(printf '%s\n' "$errors" | sed -E '/^[[:space:]]*$/d; /^failed to run commands: exit status [0-9]+$/d' | tail -n 1)
  [[ $refusal != *'Nothing was run.' && $refusal != *'Nothing was sent.' ]] || fail "$refusal"
  # A run call that the host did not refuse may have started a run: the runner can also fail

 fi
 if [[ $status != Success ]]; then
  errors=$(aws_call ssm get-command-invocation --command-id "$id" --instance-id "$instance" --query StandardErrorContent --output text) || errors=
  [[ -z $errors ]] || printf '%s\n' "$errors" >&2

 fi
 if [[ $mode == agent-wait ]]; then
  # Each call waits on the host for up to 20 seconds. Repeat until a reason other than timeout, or
  # until the time of --timeout is gone. The last object is the result.
  deadline=$(( SECONDS + wait_timeout ))
  while :; do
   left=$(( deadline - SECONDS ))
   (( left >= 1 )) || left=1
   (( left <= 20 )) || left=20
   submit "systemctl is-active --quiet cloud-workbench.service user@2200.service && ${helper/TOKIWA_QUIET=1/TOKIWA_QUIET=1 TOKIWA_WAIT_SECONDS=$left} $mode $quoted"
   if [[ $status != Success ]]; then
    errors=$(aws_call ssm get-command-invocation --command-id "$id" --instance-id "$instance" --query StandardErrorContent --output text) || errors=
    [[ -z $errors ]] || printf '%s\n' "$errors" >&2
    fail "The wait call returned $status. Nothing was changed."
   fi
   result=$(aws_call ssm get-command-invocation --command-id "$id" --instance-id "$instance" --query StandardOutputContent --output text) \
    || fail 'The wait result could not be read. Nothing was changed.'
   reason=$(printf '%s' "$result" | python3 -c 'import json,sys; print(json.load(sys.stdin)["reason"])' 2>/dev/null) \
    || fail 'The wait result could not be read. Nothing was changed.'
   if [[ $reason != timeout ]]; then printf '%s\n' "$result"; exit 0; fi
   if (( SECONDS >= deadline )); then printf '%s\n' "$result"; exit 3; fi
  done
 else
  submit "$remote"
 fi
 if [[ $sealed == 1 && $status == Success ]]; then
  open_sealed "$id"
  exit 0
 fi
 if [[ $mode == digest && $digest_json == 0 ]]; then
  aws_call ssm get-command-invocation --command-id "$id" --instance-id "$instance" --query StandardOutputContent --output text | python3 -c '
import json, sys
digest = json.load(sys.stdin)
now = digest["sampled_at"]
def span(seconds):
    seconds = max(0, now - seconds)
    for size, unit in ((86400, "d"), (3600, "h"), (60, "m")):
        if seconds >= size:
            return f"{seconds // size}{unit}"
    return "now"
rows = []
for row in digest["sessions"]:
    agent = row["agent"]
    state = f"{agent["state"]} {span(agent["at"])}" if agent else "-"
    active = row["active_at"]
    active = "active now" if active is None or span(active) == "now" else f"active {span(active)} ago"
    git = row["git"]
    if not git:
        place = "no git"
    else:
        counts = []
        if git["unpushed"] is None:
            counts.append("no upstream")
        elif git["unpushed"]:
            counts.append(f"{git["unpushed"]} unpushed")
        if git["changed"]:
            counts.append(f"{git["changed"]} changed")
        last = f"{git["commit"]} {span(git["committed_at"])} ago" if git["commit"] else "no commits"
        place = f"{git["branch"]}  {" · ".join(counts) or "up to date"}  {last}"
    rows.append((row["name"], state, active, place))
width = [max([len(r[i]) for r in rows] + [0]) for i in range(3)]
for r in rows:
    print("  ".join(r[i].ljust(width[i]) for i in range(3)) + "  " + r[3])
' || true
 else

#!/bin/bash
set -euo pipefail
# The folder of the caller, for the relative local path of tokiwa cp.
caller_dir=$PWD
cd "$HOME"
export PATH="$HOME/.local/lib/cloud-access:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export AWS_PAGER=''
mode=${1:-dashboard}
name=${2:-}
extra=
lines=
query=
digest_json=0
run_payload=
run_id=
input_file= answer_pending= answer_choice=
run_offset=
wait_timeout=600
# One cleanup for every private temporary folder: the plain text of a message, and the key of a sealed result.
input_dir= work= paste_file= paste_sha= paste_size= paste_bucket= paste_key= paste_version=
# A copy: its direction, its local and remote sides, and the temporary download file next to the target.
cp_force=0 cp_json=0 cp_direction= cp_local= cp_remote= cp_part=
# The image object of paste-image is deleted on every exit once its upload started. On a versioned
# bucket a plain delete only adds a delete marker, so the uploaded version is deleted by its id. If that
# delete fails, or the bucket gave no version id, the plain delete runs. A failed delete is silent, so
# that it never hides the first error.
cleanup() {
 [[ -z $input_dir ]] || rm -rf "$input_dir"; [[ -z $work ]] || rm -rf "$work"; [[ -z $cp_part ]] || rm -f "$cp_part"
 if [[ -n $paste_key ]]; then
  if [[ -n $paste_version && $paste_version != None && $paste_version != null ]] \
   && aws_call s3api delete-object --bucket "$paste_bucket" --key "$paste_key" --version-id "$paste_version" >/dev/null 2>&1; then :
  else aws_call s3 rm "s3://$paste_bucket/$paste_key" >/dev/null 2>&1 || true
  fi
 fi
}
trap cleanup EXIT
usage() {
 cat <<'EOF'
Usage: tokiwa [dashboard|new NAME|attach NAME|sessions|status|--check|login|capture NAME IDENTITY|state NAME IDENTITY|agent state NAME IDENTITY|agent send NAME IDENTITY|agent answer NAME IDENTITY|agent read NAME IDENTITY|claim NAME IDENTITY|release NAME IDENTITY|end NAME IDENTITY|commands|run ENTRY|run-status ID|mcp|shell|admin]

Open the dashboard. Use attach NAME to enter a terminal directly.
  dashboard     Open the Tokiwa interface (default)
  new NAME      Create an independent terminal and attach
  view NAME IDENTITY
                Watch a session read only: a key press never reaches its program
  attach NAME [IDENTITY]
                Attach to an existing terminal; with IDENTITY, only that exact session
  new NAME --from SOURCE  Open a shell in SOURCE’s current directory
  project NAME PROJECT  Put a session in a project: a name path such as studio/api, or a directory
  create NAME (--dir DIRECTORY | --folder FOLDER) [--subfolder NAME] [--project PROJECT] [--run COMMAND]
                Create a session in a directory, or in a new folder in the workbench folder;
                --run types one command line into its shell, for example an agent with its first message
  move-project FROM TO  Move a project and the projects inside it, for example api studio/api
  forget-project PROJECT  Forget a saved project without sessions; its folders stay
  name [NAME]   Show or set the name that new shells show in the prompt (default tokiwa)
  rename NAME NEW IDENTITY  Rename a session; only that exact session
  state NAME IDENTITY
                Read the facts of a session as JSON, without screen text: its program, clients, writable clients and driver
  agent state NAME IDENTITY
                The same, with what the agent in the session reports: state, turn, pending item and dialog
  agent wait NAME IDENTITY --after TURN [--timeout SECONDS]
                Wait until the agent ends a turn, asks for a person, shows a dialog or exits, then print its state with a reason
                (turn-ended, pending, dialog, ended or timeout). --timeout is 1 to 3600 seconds (default 600); a timeout exits 3
  agent send NAME IDENTITY (--text TEXT | --file PATH | -)
                Send a message to an idle agent: one paste, then Enter. Needs TOKIWA_ACTOR, which must be the driver.
                The text is at most 16384 bytes of UTF-8, with no control character except newline and tab, and does not
                start with /, ! or #. It reaches the host encrypted. The agent sees a first line that names the sender.
                The result is JSON with turn_before, the turn count to give to agent wait --after
  agent relaunch NAME IDENTITY --settings PATH [--sha256 HEX]
                Restart the Claude Code agent of an idle session with a settings file on the host: /exit, then
                claude --resume SESSION --settings PATH in the same pane. The session and the conversation stay.
                Needs TOKIWA_ACTOR, which must be the driver. The result is JSON with the session id and the file's SHA-256
  agent answer NAME IDENTITY --pending ID (--choice N | --text TEXT)
                Answer the pending question of the agent: press the digit N (1 to 9) of an option, then Enter. ID is the id of the
                pending item from agent read --pending; the question must still wait and the caller must drive. A permission item
                has no answer; refuse it with interrupt. The agent is told that an agent chose the answer, not the owner.
                --text is not supported yet and refuses. Needs TOKIWA_ACTOR
  agent read NAME IDENTITY [--after CURSOR] [--tools] [--pending]
                Read the transcript of the agent in pages, as JSON events, encrypted on the way. Without --tools a tool call and
                its result carry no text. --after CURSOR continues from the cursor of an earlier read. --pending reads the
                waiting question or permission request instead
  claim NAME IDENTITY [--replace]
                Become the driver of a session, the one actor that may send to it; the actor is TOKIWA_ACTOR.
                Refused while a client that can type is attached, and while another actor drives, unless --replace
  release NAME IDENTITY
                Give up the driver of a session; only the driver can
  end NAME IDENTITY [--attached-ok]
                End a session and the programs in its panes; refused while a client is attached, unless --attached-ok
  interrupt NAME IDENTITY
                Send Esc to a session, which stops the current turn of an agent; only that exact session
  freeze NAME IDENTITY
                Pause every process of a session until resume; only that exact session
  resume NAME IDENTITY
                Continue a frozen session
  health        Read host and workspace resource metrics
  spend         Read the instance, volumes and public addresses as JSON for the spend estimate
  sessions      List terminals and attached clients; with --json, the full session list as JSON
  search NAME IDENTITY TEXT
                Find the latest lines that hold TEXT in a session's whole scrollback, with context, as JSON
  capture NAME IDENTITY [LINES]
                Read the last lines of a session as JSON (1 to 200, default 60), encrypted on the way; only that exact session
  cp [--force] [--json] SOURCE DEST
                Copy a file or a directory between this Mac and the host. One side is SESSION:PATH, relative
                to the folder of the session, or host:/PATH. An existing target stays unless --force replaces
                a file. At most 10 GB and 10,000 files
  commands      List the entries of the owner's command list on the host, as JSON
  run ENTRY [NAME=VALUE]...
                Run an entry of the command list on the host; the result is encrypted on the way
  run-status ID [OFFSET]
                Read a run's state and the output from byte OFFSET (default 0), encrypted on the way
  secret NAME   Save a secret on the host, for example an API key; new shells load it as NAME.
                The host reads it with hidden input; it is never stored on this Mac or in AWS
  secret --remove NAME
                Remove a saved secret
  secrets       List the names of the saved secrets
  digest [--json]
                One line for each session: its agent's state, its last activity, and its folder's git state
  audit         Show the last control actions on the host: what, which session, when and from where
  status        Check AWS access, host state and the workbench server
  --check       Same as status
  login         Sign in to AWS with the profile of the host settings
  mcp [--allow control,run,commands,answer,files] [--actor NAME]
                Run the MCP server for local agents: read tools, and with --allow the tools
                that change sessions (control), run a command line on the host (run),
                run an entry of the owner's command list (commands), answer an agent's
                question (answer) or copy files in the listed folders of this Mac (files).
                --actor sets TOKIWA_ACTOR for the tools that need an actor
  shell         Open or select a terminal without the dashboard
  admin         Open the existing administrator shell

Detach: Ctrl-B, then D. Exit ends the remote shell.
Use another local terminal tab for Tokiwa controls during a connection.
Run claude auth login or codex login inside the workbench for application login.
AWS access uses the profile that ~/.config/tokiwa/host.env names. Admin access has no extra authentication.
EOF
}
agent_usage() {
 cat <<'EOF'
Usage: tokiwa agent state NAME IDENTITY
       tokiwa agent wait NAME IDENTITY --after TURN [--timeout SECONDS]
       tokiwa agent send NAME IDENTITY (--text TEXT | --file PATH | -)
       tokiwa agent answer NAME IDENTITY --pending ID (--choice N | --text TEXT)
       tokiwa agent read NAME IDENTITY [--after CURSOR] [--tools] [--pending]
       tokiwa agent relaunch NAME IDENTITY --settings PATH [--sha256 HEX]

Commands for the agent in a session, Claude Code or Codex. They read what its hooks report.
  state   The facts of the session, and the agent's state, turn, pending item and dialog, as JSON
  wait    Wait until a turn ends, an item is pending, a dialog shows or the agent exits
  send    Send a message to an idle agent; the text reaches the host encrypted
  answer  Answer the pending question of the agent by the number of an option
  read    Read the transcript of the agent in pages, or its pending item; the result is encrypted on the way
  relaunch  Restart an idle Claude Code agent with a settings file of the host, in the same pane and conversation
EOF
}
fail() { printf 'Tokiwa: %s\n' "$*" >&2; exit 1; }
# The same rules as the host, for the message in $input_file. They run here first, so that a refused
# message makes no AWS call.
check_message_text() {
  python3 -I -c '
import sys, unicodedata
data = open(sys.argv[1], "rb").read()
if len(data) > 16384:
    sys.exit("The message is over 16384 bytes. Nothing was sent.")
try:
    text = data.decode("utf-8")
except UnicodeDecodeError:
    sys.exit("The message is not UTF-8 text. Nothing was sent.")
if not text.strip():
    sys.exit("The message is empty. Nothing was sent.")
if any(unicodedata.category(c) == "Cc" and c not in "\n\t" for c in text):
    sys.exit("The message has a control character. Nothing was sent.")
if text.lstrip()[:1] in ("/", "!", "#"):
    sys.exit("The message starts with /, ! or #. Nothing was sent.")
' "$input_file" || exit 1
}
# `tokiwa agent SUBCOMMAND ...` is the agent layer. Its helper mode is `agent-SUBCOMMAND`.
if [[ $mode == agent ]]; then
 case ${2:-} in state|wait|send|answer|read|relaunch) ;; *) agent_usage >&2; exit 2 ;; esac
 set -- "agent-$2" "${@:3}"
 mode=$1
 name=${2:-}
fi
case "$mode" in
 --end-confirmed)
  [[ $# -eq 3 && $name =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]{0,47}$ && $3 =~ ^[0-9]+:\$[0-9]+:[0-9]+$ ]] || fail 'A confirmed session identity is required.'
  # A confirmed end sends what it always sent: no check for a client.
  mode=end; extra=$3 ;;
 --help|-h) usage; exit 0 ;;
 state|agent-state)
  [[ $# -eq 3 && $name =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]{0,47}$ && $3 =~ ^[0-9]+:\$[0-9]+:[0-9]+$ ]] \
   || fail 'Use state NAME IDENTITY, with the identity from tokiwa sessions --json.'
  extra=$3 ;;
 agent-wait)
  wait_usage='Use agent wait NAME IDENTITY --after TURN [--timeout SECONDS], with a timeout of 1 to 3600 seconds.'
  [[ $# -ge 5 && $# -le 7 && $name =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]{0,47}$ && $3 =~ ^[0-9]+:\$[0-9]+:[0-9]+$ && $4 == --after && $5 =~ ^[0-9]{1,9}$ ]] \
   || fail "$wait_usage"
  if [[ $# -ge 6 ]]; then
   [[ $# -eq 7 && $6 == --timeout && $7 =~ ^[0-9]{1,4}$ ]] && (( 10#$7 >= 1 && 10#$7 <= 3600 )) || fail "$wait_usage"
   wait_timeout=$((10#$7))
  fi
  extra=$3
  # The turn is the fourth argument of the helper.
  lines=$((10#$5)) ;;
 agent-read)
  read_usage='Use agent read NAME IDENTITY [--after CURSOR] [--tools] [--pending], with the cursor of an earlier read.'
  [[ $# -ge 3 && $name =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]{0,47}$ && $3 =~ ^[0-9]+:\$[0-9]+:[0-9]+$ ]] || fail "$read_usage"
  extra=$3
  read_cursor=- read_tools= read_pending=
  shift 3
  while [[ $# -gt 0 ]]; do
   case $1 in
    --after) [[ $# -ge 2 && $2 =~ ^[0-9a-f]{12}:[0-9]{1,12}$ && $read_cursor == - ]] || fail "$read_usage"
             read_cursor=$2; shift 2 ;;
    --tools) [[ -z $read_tools ]] || fail "$read_usage"; read_tools=tools; shift ;;
    --pending) [[ -z $read_pending ]] || fail "$read_usage"; read_pending=pending; shift ;;
    *) fail "$read_usage" ;;
   esac
  done
  read_flags=${read_tools:+$read_tools${read_pending:+,}}$read_pending
  read_flags=${read_flags:--} ;;
 agent-send)
  send_usage='Use agent send NAME IDENTITY (--text TEXT | --file PATH | -), with the identity from tokiwa sessions --json.'
  [[ ( $# -eq 4 && $4 == - ) || ( $# -eq 5 && ( $4 == --text || $4 == --file ) ) ]] && [[ $name =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]{0,47}$ && $3 =~ ^[0-9]+:\$[0-9]+:[0-9]+$ ]] \
   || fail "$send_usage"
  [[ ${TOKIWA_ACTOR:-} =~ ^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$ ]] \
   || fail 'Set TOKIWA_ACTOR to the name of the caller: 1 to 64 letters, digits, dots, colons, hyphens or underscores. Nothing was sent.'
  extra=$3
  # A private folder, removed when this command ends, holds the text until it is encrypted. The text is
  # written by builtins and redirections only: never as an argument of a program, never in a here-string.
  input_dir=$(umask 077; mktemp -d "${TMPDIR:-/tmp}/tokiwa-input.XXXXXX") || fail 'A message needs a temporary folder.'
  input_file=$input_dir/message
  case $4 in
   --text) printf '%s' "$5" > "$input_file" ;;
   --file) [[ -f $5 && -r $5 ]] || fail 'The message file cannot be read. Nothing was sent.'
           head -c 16385 < "$5" > "$input_file" ;;
   -) head -c 16385 > "$input_file" ;;
  esac
  check_message_text ;;
 agent-answer)
  answer_usage='Use agent answer NAME IDENTITY --pending ID (--choice N | --text TEXT), with N from 1 to 9.'
  [[ $# -eq 7 && $name =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]{0,47}$ && $3 =~ ^[0-9]+:\$[0-9]+:[0-9]+$ && $4 == --pending && $5 =~ ^[A-Za-z0-9_.:-]{1,128}$ ]] \
   || fail "$answer_usage"
  [[ ${TOKIWA_ACTOR:-} =~ ^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$ ]] \
   || fail 'Set TOKIWA_ACTOR to the name of the caller: 1 to 64 letters, digits, dots, colons, hyphens or underscores. Nothing was sent.'
  extra=$3
  answer_pending=$5
  case $6 in
   --choice) [[ $7 =~ ^[1-9]$ ]] || fail "$answer_usage"
             answer_choice=$7 ;;
   --text) answer_choice=text
           # The same private folder and the same text checks as agent send.
           input_dir=$(umask 077; mktemp -d "${TMPDIR:-/tmp}/tokiwa-input.XXXXXX") || fail 'A message needs a temporary folder.'
           input_file=$input_dir/message
           printf '%s' "$7" > "$input_file"
           check_message_text ;;
   *) fail "$answer_usage" ;;
  esac ;;
 paste-image)
  # Internal command of the app: it is not in the help. The file is checked here, before any AWS call.
  [[ $# -eq 4 && $name =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]{0,47}$ && $3 =~ ^[0-9]+:\$[0-9]+:[0-9]+$ ]] || fail 'Use paste-image NAME IDENTITY FILE.'
  extra=$3
  paste_file=$4
  paste_facts=$([[ -f $paste_file && -r $paste_file ]] && python3 -I -c '
import hashlib, sys
data = open(sys.argv[1], "rb").read(10485761)
if len(data) > 10485760 or not data.startswith(b"\x89PNG\r\n\x1a\n"):
    sys.exit(1)
print(hashlib.sha256(data).hexdigest(), len(data))
' "$paste_file" 2>/dev/null) || fail 'The file is not a PNG image of at most 10 MB.'
  read -r paste_sha paste_size <<< "$paste_facts" ;;
 agent-relaunch)
  relaunch_usage='Use agent relaunch NAME IDENTITY --settings PATH [--sha256 HEX], with an absolute path on the host.'
  [[ ( $# -eq 5 || ( $# -eq 7 && $6 == --sha256 && $7 =~ ^[0-9a-f]{64}$ ) ) && $name =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]{0,47}$ && $3 =~ ^[0-9]+:\$[0-9]+:[0-9]+$ && $4 == --settings && $5 =~ ^/[A-Za-z0-9._/-]+$ && ${#5} -le 1001 ]] \
   || fail "$relaunch_usage"
  [[ ${TOKIWA_ACTOR:-} =~ ^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$ ]] \
   || fail 'Set TOKIWA_ACTOR to the name of the caller: 1 to 64 letters, digits, dots, colons, hyphens or underscores. Nothing was changed.'
  extra=$3
  relaunch_settings=$5
  relaunch_digest=${7:--} ;;
 claim|release)
  [[ ( $# -eq 3 || ( $mode == claim && $# -eq 4 && $4 == --replace ) ) && $name =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]{0,47}$ && $3 =~ ^[0-9]+:\$[0-9]+:[0-9]+$ ]] \
   || fail "Use $mode NAME IDENTITY$([[ $mode == claim ]] && echo ' [--replace]')."
  [[ ${TOKIWA_ACTOR:-} =~ ^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$ ]] \
   || fail "Set TOKIWA_ACTOR to the name of the caller: 1 to 64 letters, digits, dots, colons, hyphens or underscores. Nothing was changed."
  extra=$3
  # The host reads the actor from the environment that the launcher sets below.
  [[ $# -eq 3 ]] || lines=replace ;;
 end)
  [[ ( $# -eq 3 || ( $# -eq 4 && $4 == --attached-ok ) ) && $name =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]{0,47}$ && $3 =~ ^[0-9]+:\$[0-9]+:[0-9]+$ ]] \
   || fail 'Use end NAME IDENTITY [--attached-ok].'
  extra=$3
  # The host refuses an attached session when it gets check-clients; --attached-ok sends no flag.
  [[ $# -eq 4 ]] || lines=check-clients ;;
 new|attach|view|project)
  [[ $# -ge 2 && $name =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]{0,47}$ ]] || fail 'Use a session name of 1 to 48 letters, digits, hyphens or underscores. Start with a letter or digit.'
  if [[ $mode == new && $# -eq 4 && $3 == --from ]]; then
   [[ $4 =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]{0,47}$ ]] || fail 'The source session name is invalid.'
   extra=$4
  elif [[ ( $mode == attach || $mode == view ) && $# -eq 3 ]]; then
   [[ $3 =~ ^[0-9]+:\$[0-9]+:[0-9]+$ ]] || fail 'The session identity is invalid. Refresh the session list.'
   extra=$3
  elif [[ $mode == view ]]; then
   fail 'Use view NAME IDENTITY.'
  elif [[ $mode == project && $# -eq 3 ]]; then
   [[ $3 == /* || $3 =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,47}(/[A-Za-z0-9][A-Za-z0-9_.-]{0,47}){0,5}$ ]] || fail 'Use a project name path such as studio/api, or an absolute directory.'
   extra=$(python3 -c 'import base64,sys; print(base64.b64encode(sys.argv[1].encode()).decode())' "$3")
  else
   [[ $# -eq 2 && $mode != project ]] || fail 'Use new NAME --from SOURCE or project NAME PROJECT.'
  fi ;;
 create)
  [[ $# -ge 2 && $name =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]{0,47}$ ]] || fail 'Use a session name of 1 to 48 letters, digits, hyphens or underscores. Start with a letter or digit.'
  # The command line of --run is message text for a session: it never goes into the request. The
  # request says run_stdin, and the line travels encrypted (see seal_input below).
  create_out=$(python3 - "${@:3}" <<'PY_CREATE'
import base64, json, sys
args, want = sys.argv[1:], {}
keys = {'--dir': 'dir', '--folder': 'folder', '--project': 'project', '--subfolder': 'subfolder', '--run': 'run'}
while args:
    if len(args) < 2 or args[0] not in keys or keys[args[0]] in want:
        raise SystemExit('Tokiwa: Use create NAME (--dir DIRECTORY | --folder FOLDER) [--subfolder NAME] [--project PROJECT] [--run COMMAND].')
    want[keys[args[0]]] = args[1]
    args = args[2:]
if ('dir' in want) == ('folder' in want):
    raise SystemExit('Tokiwa: Use create NAME (--dir DIRECTORY | --folder FOLDER) [--subfolder NAME] [--project PROJECT] [--run COMMAND].')
run = want.pop('run', None)
if run is not None:
    want['run_stdin'] = True
print(base64.b64encode(json.dumps(want).encode()).decode())
print(base64.b64encode(run.encode()).decode() if run is not None else '-')
PY_CREATE
) || exit 1
  # A here-string would put the line in a temporary file on this Mac, so a process substitution reads it.
  { read -r extra; read -r run_b64; } < <(printf '%s\n' "$create_out")
  if [[ $run_b64 != - ]]; then
   # A private folder, removed when this command ends, holds the line until it is encrypted.
   input_dir=$(umask 077; mktemp -d "${TMPDIR:-/tmp}/tokiwa-input.XXXXXX") || fail 'A command to run needs a temporary folder.'
   input_file=$input_dir/line
   printf '%s' "$run_b64" | base64 --decode > "$input_file"
  fi ;;
 move-project)
  [[ $# -eq 3 ]] || fail 'Use move-project FROM TO, for example api studio/api.'
  name=$(python3 -c 'import base64,json,sys; print(base64.b64encode(json.dumps({"from":sys.argv[1],"to":sys.argv[2]}).encode()).decode())' "$2" "$3")
  mode=relabel ;;
 rename)
  [[ $# -eq 4 && $name =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]{0,47}$ && $3 =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]{0,47}$ && $4 =~ ^[0-9]+:\$[0-9]+:[0-9]+$ ]] || fail 'Use rename NAME NEW IDENTITY; names are 1 to 48 letters, digits, hyphens or underscores.'
  extra=$(python3 -c 'import base64,json,sys; print(base64.b64encode(json.dumps({"to":sys.argv[1],"identity":sys.argv[2]}).encode()).decode())' "$3" "$4") ;;
 forget-project)
  [[ $# -eq 2 ]] || fail 'Use forget-project PROJECT.'
  name=$(python3 -c 'import base64,sys; print(base64.b64encode(sys.argv[1].encode()).decode())' "$2") ;;
 name)
  [[ $# -le 2 ]] || fail 'Use name [NAME].'
  [[ -z $name || $name =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]{0,23}$ ]] || fail 'Use a name of 1 to 24 letters, digits, hyphens or underscores. Start with a letter or digit.' ;;

 capture)
  [[ $# -ge 3 && $# -le 4 && $2 =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]{0,47}$ && $3 =~ ^[0-9]+:\$[0-9]+:[0-9]+$ ]] || fail 'Use capture NAME IDENTITY [LINES].'
  lines=${4:-60}
  [[ $lines =~ ^[0-9]{1,3}$ ]] && (( lines >= 1 && lines <= 200 )) || fail 'Use a line count from 1 to 200.'
  extra=$3 ;;
 secret)
  if [[ $# -eq 3 && $name == --remove ]]; then
   name=$3
   mode=secret-remove
  else
   [[ $# -eq 2 && $name != --remove ]] || fail 'Use secret NAME, or secret --remove NAME.'
   # The host reads the value with hidden input, so the command needs a terminal.
   [[ -t 0 && -t 1 ]] || fail 'Use an interactive terminal for this command: the value is read with hidden input.'
  fi
  # A secret becomes an environment variable of each new shell; the names that shells and Tokiwa use are refused.
  [[ $name =~ ^[A-Za-z_][A-Za-z0-9_]{0,63}$ && ! $name =~ ^(PATH|HOME|SHELL|USER|LOGNAME|PWD|BROWSER|PS1|TOKIWA_.*|TMUX.*)$ ]] \
   || fail 'Use a secret name of letters, digits and underscores, for example OPENAI_API_KEY. PATH, HOME, SHELL, USER, LOGNAME, PWD, BROWSER, PS1 and names that start with TOKIWA_ or TMUX are refused.' ;;
 secrets) [[ $# -le 1 ]] || fail 'Use secrets.' ;;
 input-cert) [[ $# -eq 1 ]] || fail 'Use input-cert.' ;;
 commands) [[ $# -eq 1 ]] || fail 'Use commands.' ;;
 run)
  run_usage='Use run ENTRY NAME=VALUE…, with names from tokiwa commands.'
  [[ $# -ge 2 && $# -le 18 && $name =~ ^[a-z][a-z0-9_-]{0,47}$ ]] || fail "$run_usage"
  for pair in "${@:3}"; do
   key=${pair%%=*} value=${pair#*=}
   [[ $pair == *=* && $key =~ ^[a-z][a-z0-9_-]{0,47}$ && -n $value && ${#value} -le 1000 && $value != *[[:cntrl:]]* ]] || fail "$run_usage"
  done
  run_payload=$(python3 - "$name" "${@:3}" <<'PY_RUN'
import base64, json, sys
entry, args = sys.argv[1], {}
for pair in sys.argv[2:]:
    key, value = pair.split('=', 1)
    args[key] = value
print(base64.b64encode(json.dumps({"entry": entry, "args": args}).encode()).decode())
PY_RUN
) || fail "$run_usage"
  name= ;;
 run-status)
  [[ $# -ge 2 && $# -le 3 && $name =~ ^[0-9]{8}T[0-9]{6}-[0-9a-f]{4}$ && ${3:-0} =~ ^[0-9]{1,12}$ ]] || fail 'Use run-status ID [OFFSET], with the id from tokiwa run.'
  run_id=$name run_offset=${3:-0}
  name= ;;
 interrupt|freeze|resume)
  [[ $# -eq 3 && $name =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]{0,47}$ && $3 =~ ^[0-9]+:\$[0-9]+:[0-9]+$ ]] \
   || fail "Use $mode NAME IDENTITY, with the identity from tokiwa sessions --json."
  extra=$3 ;;
 digest)
  if [[ $# -eq 2 && $2 == --json ]]; then digest_json=1; name=
  else [[ $# -le 1 ]] || fail 'Use digest or digest --json.'; fi ;;
 search)
  # A capture that reads the whole scrollback for the lines that hold the text.
  [[ $# -eq 4 && $2 =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]{0,47}$ && $3 =~ ^[0-9]+:\$[0-9]+:[0-9]+$ && -n $4 && ${#4} -le 200 && $4 != *[[:cntrl:]]* ]] \
   || fail 'Use search NAME IDENTITY TEXT, with a text of 1 to 200 printable characters.'
  extra=$3
  lines=50
  query=$(printf '%s' "$4" | base64 | tr -d '\n')
  mode=capture ;;
 sessions)
  if [[ $# -eq 2 && $2 == --json ]]; then mode=--snapshot; name=
  else [[ $# -le 1 ]] || fail 'Use sessions or sessions --json.'; fi ;;
 health|spend|dashboard|--snapshot|shell|admin|list|status|--check|login|audit) [[ $# -le 1 ]] || fail 'Too many arguments.' ;;
 cp)
  shift
  while [[ ${1:-} == --* ]]; do
   case $1 in
    --force) cp_force=1 ;;
    --json) cp_json=1 ;;
    *) fail 'Use cp [--force] [--json] SOURCE DEST.' ;;
   esac
   shift
  done
  [[ $# -eq 2 && -n $1 && -n $2 ]] || fail 'Use cp [--force] [--json] SOURCE DEST.'
  # The remote side is host:/PATH or SESSION:PATH. A local name with a colon is written ./NAME, as with scp.
  remote_side() {
   if [[ $1 =~ ^host:(/.*)$ ]]; then printf '%s' "${BASH_REMATCH[1]}"
   elif [[ $1 =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]{0,47}: ]]; then printf '%s' "$1"
   else return 1; fi
  }
  if from=$(remote_side "$1"); then
   ! remote_side "$2" >/dev/null || fail 'One side of cp is on this Mac and one is on the host.'
   cp_direction=down cp_remote=$from cp_local=$2
  elif to=$(remote_side "$2"); then
   cp_direction=up cp_remote=$to cp_local=$1
  else
   fail 'One side of cp is on the host: SESSION:PATH or host:/PATH.'
  fi
  [[ $cp_local == /* ]] || cp_local=$caller_dir/$cp_local
  name= ;;
 mcp)
  # --allow adds the tools that change a session (control), run a command line on the host (run),
  # run an entry of the owner's command list (commands) or answer an agent's question (answer):
  # one to four distinct classes. --actor names the caller for the tools that need an actor.
  # Each option appears at most once, in either order.
  mcp_args=("${@:2}")
  shift
  allow_seen= actor_seen=
  while [[ $# -gt 0 ]]; do
   case $1 in
    --allow)
     [[ -z $allow_seen && $# -ge 2 && $2 =~ ^(control|run|commands|answer|files)(,(control|run|commands|answer|files)){0,4}$ ]] \
      && IFS=, read -ra picked <<<"$2" \
      && [[ $(printf '%s\n' "${picked[@]}" | sort -u | wc -l) -eq ${#picked[@]} ]] \
      || fail 'Use mcp [--allow CLASSES] [--actor NAME]: CLASSES are control, run, commands, answer or files, joined by commas, each once.'
     allow_seen=1; shift 2 ;;
    --actor)
     [[ -z $actor_seen && $# -ge 2 && $2 =~ ^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$ ]] \
      || fail 'Use mcp [--allow CLASSES] [--actor NAME]: NAME is 1 to 64 letters, digits, dots, colons, hyphens or underscores.'
     actor_seen=1; shift 2 ;;
    *) fail 'Use mcp [--allow CLASSES] [--actor NAME]: CLASSES are control, run, commands, answer or files, joined by commas, each once.' ;;
   esac
  done
  ;;
 *) usage >&2; exit 2 ;;
esac
# The MCP server reports a missing host setting as a tool error, so it starts without the settings.
if [[ $mode == mcp ]]; then
 app="$HOME/.local/lib/tokiwa/opentui/run"
 [[ -x $app ]] || fail 'The Tokiwa interface is not installed. Run app/install.sh.'
 exec "$app" mcp ${mcp_args[@]+"${mcp_args[@]}"}
fi
# The host settings: KEY=VALUE lines. The file is read, never run. See docs/configuration.md.
config=${TOKIWA_HOST_CONFIG:-$HOME/.config/tokiwa/host.env}
[[ -r $config ]] || fail "Set the host in $config: instance=, profile= and region=, and optionally account= and end=."
instance= profile= region= account= end= paste_bucket=
while IFS= read -r line || [[ -n $line ]]; do
 [[ $line =~ ^[[:space:]]*(#.*)?$ ]] && continue
 [[ $line =~ ^(instance|profile|region|account|end|paste_bucket)=([A-Za-z0-9._:+-]*)$ ]] || fail "$config has a line that is not KEY=VALUE for instance, profile, region, account, end or paste_bucket."
 printf -v "${BASH_REMATCH[1]}" '%s' "${BASH_REMATCH[2]}"
done < "$config"
[[ $instance =~ ^i-[0-9a-f]{8,17}$ ]] || fail "$config: instance= must be an EC2 instance ID, for example i-0123456789abcdef0."
[[ -n $profile ]] || fail "$config: profile= must name an AWS CLI profile."
[[ $region =~ ^[a-z]{2}(-[a-z]+)+-[0-9]$ ]] || fail "$config: region= must be an AWS region, for example us-east-1."
[[ -z $account || $account =~ ^[0-9]{12}$ ]] || fail "$config: account= must be a 12-digit AWS account ID."
[[ -z $paste_bucket || $paste_bucket =~ ^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$ ]] || fail "$config: paste_bucket= must be an S3 bucket name."
[[ $mode != paste-image || -n $paste_bucket ]] || fail 'Image paste is not set up. Set paste_bucket= in ~/.config/tokiwa/host.env.'
[[ $mode != cp || -n $paste_bucket ]] || fail 'File transfer is not set up. Set paste_bucket= in ~/.config/tokiwa/host.env.'
if [[ -n $end ]]; then
 # An end time with an offset, for example 2026-12-31T23:59:00-08:00. After it, Tokiwa starts no connection.
 end_epoch=$(python3 -c 'import datetime,sys; t=datetime.datetime.fromisoformat(sys.argv[1].replace("Z","+00:00")); assert t.tzinfo; print(int(t.timestamp()))' "$end" 2>/dev/null) \
  || fail "$config: end= must be a time with an offset, for example 2026-12-31T23:59:00-08:00."
 [[ $(date -u +%s) -lt $end_epoch ]] || fail "The end time in $config has passed. No host was started."
fi
if [[ $mode == dashboard ]]; then
 # The interface, installed by app/install.sh. It calls this launcher for every
 # AWS and tmux operation. The other commands, for example attach NAME, work without it.
 app="$HOME/.local/lib/tokiwa/opentui/run"
 [[ -t 0 && -t 1 ]] || fail 'Use an interactive terminal for this command.'
 [[ -x $app ]] || fail 'The Tokiwa interface is not installed. Run app/install.sh, or use tokiwa attach NAME.'
 exec "$app"
fi
# aws sso login opens the sign-in link with Python webbrowser, which uses BROWSER when it is set.
# TOKIWA_SIGN_IN_BROWSER names the program that receives the link, and BROWSER is set for this one command only.
sso_login() {
 local opener=${TOKIWA_SIGN_IN_BROWSER:-}
 if [[ -z $opener ]]; then
  aws sso login --profile "$profile"
  return
 fi
 [[ -f $opener && -x $opener && $opener != *[:%]* ]] || fail 'TOKIWA_SIGN_IN_BROWSER must name an executable file. Its path cannot contain : or %.'
 printf 'Tokiwa · the sign-in opens with TOKIWA_SIGN_IN_BROWSER. If the page shows an error, press Ctrl-C and sign in again.\n' >&2
 BROWSER="$opener" aws sso login --profile "$profile"
}
if [[ $mode == login ]]; then
 [[ -t 0 && -t 1 ]] || fail 'Use an interactive terminal for this command.'
 sso_login
 exit
fi
note() { [[ ${TOKIWA_DASHBOARD:-0} == 1 ]] || printf "$@"; }
aws_call() { aws --profile "$profile" --region "$region" --cli-connect-timeout 5 --cli-read-timeout 10 "$@"; }
# The category of a failed access check, from the AWS CLI text of botocore's connection errors:
# EndpointConnectionError, ConnectTimeoutError, ReadTimeoutError and ConnectionClosedError.
# Any other failure, for example an expired token, is auth.
aws_access_category() {
 case $1 in
  *'Could not connect to the endpoint URL'* | *'Connect timeout on endpoint URL'* | *'Read timeout on endpoint URL'* | *'Connection was closed before we received a valid response from endpoint URL'*) printf 'unreachable' ;;
  *) printf 'auth' ;;
 esac
}
# fail, then name the category on the last line of stderr when the caller asked for it.
fail_access() {
 printf 'Tokiwa: %s\n' "$2" >&2
 [[ ${TOKIWA_ERROR_CATEGORY:-0} != 1 ]] || printf 'tokiwa-error: %s\n' "$1" >&2
 exit 1
}
note 'Tokiwa · checking AWS access…\n' >&2
# The SSO session ends after the organization's sign-in time limit. In an interactive terminal, start the browser
# login and continue. The dashboard and scripted calls keep failing with the command to run.
# A network failure fails at once, because a sign-in cannot fix it.
access_err=$(mktemp)
if ! signed_in=$(aws_call sts get-caller-identity --query Account --output text 2>"$access_err"); then
 access_text=$(<"$access_err")
 rm -f "$access_err"
 [[ $(aws_access_category "$access_text") == auth ]] || fail_access unreachable 'AWS cannot be reached from this Mac. Check the network, then retry.'
 [[ -t 0 && -t 1 && ${TOKIWA_DASHBOARD:-0} != 1 ]] || fail_access auth "AWS authentication failed. Run aws sso login --profile $profile."
 note "Tokiwa · AWS sign-in expired; starting aws sso login --profile ${profile}…\\n" >&2
 sso_login >&2 || fail_access auth "The AWS login did not complete. Run aws sso login --profile $profile."
 signed_in=$(aws_call sts get-caller-identity --query Account --output text) || fail_access auth "AWS authentication failed. Run aws sso login --profile $profile."
else
 rm -f "$access_err"
fi
[[ -z $account || $signed_in == "$account" ]] || fail "The AWS account does not match account= in $config."
if [[ $mode == spend ]]; then
 # Read-only inventory for the local spend estimate. A stopped host still has volumes and addresses.
 instance_json=$(aws_call ec2 describe-instances --instance-ids "$instance" --query 'Reservations[0].Instances[0].{type:InstanceType,state:State.Name,launch_time:LaunchTime,public_ip:PublicIpAddress,availability_zone:Placement.AvailabilityZone}' --output json) || fail 'The instance could not be read.'
 volumes_json=$(aws_call ec2 describe-volumes --filters "Name=attachment.instance-id,Values=$instance" --query 'Volumes[].{id:VolumeId,type:VolumeType,size_gib:Size,iops:Iops,throughput:Throughput}' --output json) || fail 'The volumes could not be read.'
 addresses_json=$(aws_call ec2 describe-addresses --filters "Name=instance-id,Values=$instance" --query 'Addresses[].{public_ip:PublicIp,allocation_id:AllocationId}' --output json) || fail 'The public addresses could not be read.'
 exec python3 -c '
import json, sys, time
instance, volumes, addresses = (json.loads(value) for value in sys.argv[2:5])
if not isinstance(instance, dict) or not isinstance(volumes, list) or not isinstance(addresses, list):
    sys.exit("Tokiwa: The instance inventory is invalid.")
print(json.dumps({"instance_id": sys.argv[1], "region": sys.argv[5], "read_at": time.time(), "instance": instance, "volumes": volumes, "addresses": addresses}))
' "$instance" "$instance_json" "$volumes_json" "$addresses_json" "$region"
fi
state=$(aws_call ec2 describe-instances --instance-ids "$instance" --query 'Reservations[0].Instances[0].State.Name' --output text) || fail 'The host state could not be read.'
[[ $state == running ]] || fail "The host is $state. No restart was requested."
note 'Tokiwa · host running\n' >&2
# The interface that asked, for the audit log on the host: this command, the MCP server or the app.
via=${TOKIWA_VIA:-cli}
[[ $via =~ ^(cli|mcp|app)$ ]] || via=cli
# The caller may also name itself, for example an orchestrator's session; a malformed name is left out.
actor=${TOKIWA_ACTOR:-}
[[ $actor =~ ^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$ ]] || actor=
helper="sudo -n runuser -u agent-workspace -- env TOKIWA_QUIET=1 TOKIWA_VIA=$via${actor:+ TOKIWA_ACTOR=$actor} /opt/agent-platform/rootless/terminal-session.sh"
case "$mode" in
 list) mode=sessions ;;
 --check) mode=status ;;
 --snapshot) mode=snapshot ;;
esac
if [[ $mode == cp || $mode == status || $mode == sessions || $mode == snapshot || $mode == project || $mode == health || $mode == end || $mode == claim || $mode == release || $mode == create || $mode == relabel || $mode == forget-project || $mode == name || $mode == rename || $mode == capture || $mode == secrets || $mode == secret-remove || $mode == interrupt || $mode == freeze || $mode == resume || $mode == state || $mode == agent-state || $mode == agent-wait || $mode == agent-send || $mode == agent-answer || $mode == agent-relaunch || $mode == paste-image || $mode == agent-read || $mode == audit || $mode == digest || $mode == commands || $mode == run || $mode == run-status || $mode == input-cert ]]; then
 remote="systemctl is-active --quiet cloud-workbench.service user@2200.service && $helper $mode"
 [[ $mode != health ]] || remote="$helper health"
 if [[ -n $name ]]; then
  quoted=$(python3 -c 'import shlex,sys; print(" ".join(shlex.quote(x) for x in sys.argv[1:]))' "$name" "$extra" ${lines:+"$lines"} ${answer_pending:+"$answer_pending" "$answer_choice"} ${paste_sha:+"$paste_sha" "$paste_size"} ${relaunch_settings:+"$relaunch_settings" "$relaunch_digest"})
  remote="$remote $quoted"
 fi
 # Run Command keeps its output in the account, so the host encrypts a result to a key that
 # exists only on this Mac and only for this call.
 sealed_key() {
  command -v openssl >/dev/null || fail "A $what needs openssl."
  umask 077
  work=$(mktemp -d "${TMPDIR:-/tmp}/tokiwa-capture.XXXXXX") || fail "A $what needs a temporary folder."
  openssl req -x509 -newkey rsa:3072 -nodes -keyout "$work/key.pem" -out "$work/cert.pem" -subj /CN=tokiwa-capture -days 1 >/dev/null 2>&1 \
   || fail "The $what key could not be made."
  cert64=$(base64 < "$work/cert.pem" | tr -d '\n')
 }
 # Read the sealed result of Run Command call $1 and decrypt it to stdout.
 open_sealed() {
  aws_call ssm get-command-invocation --command-id "$1" --instance-id "$instance" --query StandardOutputContent --output text > "$work/sealed" \
   || fail "The $what could not be read."
  python3 -c 'import base64,sys; sys.stdout.buffer.write(base64.b64decode(open(sys.argv[1]).read()))' "$work/sealed" > "$work/sealed.der" 2>/dev/null \
   || fail "The $what could not be decrypted."
  # To stdout, so that the decrypted text is never in a file.
  openssl smime -decrypt -binary -inform DER -inkey "$work/key.pem" -recip "$work/cert.pem" -in "$work/sealed.der" 2>/dev/null \
   || fail "The $what could not be decrypted."
 }
 what=capture
 sealed=0
 runner="env TOKIWA_VIA=$via${actor:+ TOKIWA_ACTOR=$actor} python3 -I /opt/agent-platform/rootless/tokiwa-run.py"
 if [[ $mode == capture ]]; then
  sealed=1
  sealed_key
  remote="$remote $cert64${query:+ $query}"
 elif [[ $mode == agent-read ]]; then
  # Like a capture, the host seals the result to a key that exists only for this call.
  sealed=1
  what='transcript read'
  sealed_key
  remote="$remote $read_cursor $read_flags $cert64"
 elif [[ $mode == commands ]]; then
  remote="$runner commands"
 elif [[ $mode == run || $mode == run-status ]]; then
  # Run Command runs the runner as root; the payload is base64, the id and offset are checked above.
  sealed=1
  what='run result'
  sealed_key
  if [[ $mode == run ]]; then remote="$runner start $run_payload $cert64"
  else remote="$runner status $run_id $run_offset $cert64"; fi
 fi
 # Submit command line $1 to Run Command and wait for its end. Sets id and status.
 submit() {
  local parameters
  parameters=$(python3 -c 'import json,sys; print(json.dumps({"commands":[sys.argv[1]],"executionTimeout":[sys.argv[2]]}))' "$1" "${exec_timeout:-30}")
  id=$(aws_call ssm send-command --instance-ids "$instance" --document-name AWS-RunShellScript --parameters "$parameters" --query Command.CommandId --output text) || fail 'The host check could not be submitted.'
  status=Pending
  local attempt
  for (( attempt = 1; attempt <= tries; attempt++ )); do
   status=$(aws_call ssm get-command-invocation --command-id "$id" --instance-id "$instance" --query Status --output text 2>/dev/null) || status=Pending
   case "$status" in Success|Failed|Cancelled|TimedOut) break ;; esac
   sleep 1
  done
 }
 # A sealed call ends on the host, so wait for its end: Run Command stops it after 30 seconds.
 # A wait call holds the host for up to 20 seconds, so it gets the same time.
 tries=15
 [[ $sealed == 0 && $mode != agent-wait && $mode != agent-relaunch && $mode != paste-image ]] || tries=40
 if [[ $mode == cp ]]; then
  # One file or directory through the bucket: inputs/transfers/ toward the host, results/transfers/ from
  # it. The cleanup deletes the object on every exit, as it does for an image paste. On the host, root
  # moves the bytes between the object and the helper, and the helper does every path check.
  read -r -d '' cp_program <<'PY_CP' || true
import hashlib, json, os, shutil, stat, sys, tarfile, tempfile
from pathlib import Path
MAX_BYTES = 10 * 1024**3
MAX_FILES = 10000
# A stream is the content plus, for a directory, the tar headers: about 1.5 KB for each entry.
STREAM_LIMIT = MAX_BYTES + 64 * 1024**2
# The room that a download leaves free on this Mac.
MARGIN = 1024**3
CHUNK = 1024 * 1024
LIMIT = "A transfer holds at most 10 GB. Nothing was copied."

def count_tree(top):
    entries, total = 1, 0
    for folder, dirs, files in os.walk(top):
        for entry in dirs + files:
            path = Path(folder) / entry
            info = path.lstat()
            if not (stat.S_ISREG(info.st_mode) or stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode)):
                sys.exit(f"{path} is not a file, a folder or a link. Nothing was copied.")
            entries += 1
            total += info.st_size if stat.S_ISREG(info.st_mode) else 0
            if entries > MAX_FILES:
                sys.exit(f"The directory holds more than {MAX_FILES} entries. Nothing was copied.")
            if total > MAX_BYTES:
                sys.exit(LIMIT)
    return entries, total

def plain_member(member):
    member.uid = member.gid = 0
    member.uname = member.gname = ""
    return member

class Hashing:
    def __init__(self, out):
        self.out, self.size, self.digest = out, 0, hashlib.sha256()
    def write(self, data):
        self.size += len(data)
        self.digest.update(data)
        return self.out.write(data)
    def flush(self):
        self.out.flush()

def sha256_of(path):
    digest, size = hashlib.sha256(), 0
    with open(path, "rb") as stream:
        while chunk := stream.read(CHUNK):
            digest.update(chunk)
            size += len(chunk)
    return digest.hexdigest(), size

def allowed(given, direction, listing, default):
    """Refuse a local path of an MCP copy outside the folders that the owner listed."""
    try:
        lines = Path(listing).read_text().splitlines()
        folders = [os.path.expanduser(l.strip()) for l in lines if l.strip() and not l.strip().startswith("#")]
    except FileNotFoundError:
        os.makedirs(default, mode=0o700, exist_ok=True)
        folders = [default]
    given = Path(given)
    real = Path(os.path.realpath(given))
    if direction == "down" and not real.is_dir():
        real = Path(os.path.realpath(given.parent))
    for folder in folders:
        root = Path(os.path.realpath(folder))
        if folder.startswith("/") and (real == root or real.is_relative_to(root)):
            return
    sys.exit(f"An MCP copy can use only the folders that {listing} lists (without the file: {default}). Nothing was copied.")

def check(given):
    given = Path(given)
    real = Path(os.path.realpath(given))
    if not real.exists():
        sys.exit(f"{given} does not exist. Nothing was copied.")
    name = given.name or real.name
    if "\n" in name:
        sys.exit("The name has a line break. Nothing was copied.")
    if real.is_file():
        size = real.stat().st_size
        if size > MAX_BYTES:
            sys.exit(LIMIT)
        facts = {"kind": "file", "name": name, "files": 1, "mode": real.stat().st_mode & 0o777, "size": size}
    elif real.is_dir():
        entries, total = count_tree(real)
        facts = {"kind": "dir", "name": name, "files": entries, "mode": real.stat().st_mode & 0o777, "size": total}
    else:
        sys.exit(f"{given} is not a file or a folder. Nothing was copied.")
    print(json.dumps(facts))

def stream(given, facts, sent):
    facts = json.loads(facts)
    out = Hashing(sys.stdout.buffer)
    real = os.path.realpath(given)
    if facts["kind"] == "file":
        with open(real, "rb") as source:
            while chunk := source.read(CHUNK):
                out.write(chunk)
    else:
        with tarfile.open(fileobj=out, mode="w|", format=tarfile.PAX_FORMAT) as archive:
            archive.add(real, arcname=facts["name"], filter=plain_member)
    out.flush()
    Path(sent).write_text(json.dumps({"bytes": out.size, "sha256": out.digest.hexdigest()}))

def within(name, path):
    return (path == name or path.startswith(name + "/")) and ".." not in path.split("/")

def link_within(name, member):
    # The data filter keeps a link inside the staging folder only; NAME is one level deeper.
    if member.issym():
        if member.linkname.startswith("/"):
            return False
        return within(name, os.path.normpath(os.path.join(os.path.dirname(member.name), member.linkname)))
    if member.islnk():
        return within(name, os.path.normpath(member.linkname))
    return True

def prepare(report, given, force):
    report, dest = json.loads(report), Path(given)
    name, kind = report["name"], report["kind"]
    if not name or "/" in name or name in (".", "..") or "\n" in name:
        sys.exit("The host sent a name that is not valid. Nothing was copied.")
    if report["bytes"] > STREAM_LIMIT:
        sys.exit(LIMIT)
    real = Path(os.path.realpath(dest))
    if real.is_dir():
        folder, target = real, real / name
    else:
        if given.endswith("/"):
            sys.exit(f"The folder {dest} does not exist. Nothing was copied.")
        # A link as the target could name a file on another disk or anywhere on this Mac.
        if dest.is_symlink():
            sys.exit(f"{dest} is a link. Name the file that it points to. Nothing was copied.")
        folder = Path(os.path.realpath(dest.parent))
        if not folder.is_dir():
            sys.exit(f"The folder {dest.parent} does not exist. Nothing was copied.")
        target = folder / dest.name
    if os.path.lexists(target):
        if kind == "dir" or target.is_dir():
            sys.exit(f"{target} exists. A directory is never replaced. Nothing was copied.")
        if force != "1":
            sys.exit(f"{target} exists. Use --force to replace it. Nothing was copied.")
        if target.is_symlink() or not target.is_file():
            sys.exit(f"{target} is not a regular file. Nothing was copied.")
    if kind == "dir" and not hasattr(tarfile, "data_filter"):
        sys.exit("A directory needs Python 3.12 or newer on this Mac. Nothing was copied.")
    if shutil.disk_usage(folder).free < report["bytes"] * (2 if kind == "dir" else 1) + MARGIN:
        sys.exit(f"This Mac has no room for {report['bytes']} bytes in {folder}. Nothing was copied.")
    descriptor, part = tempfile.mkstemp(prefix=".tokiwa-cp-", suffix=".part", dir=folder)
    os.close(descriptor)
    print(part)
    print(target)

def place(report, target, part, force):
    report, target = json.loads(report), Path(target)
    sha256, size = sha256_of(part)
    if (sha256, size) != (report["sha256"], report["bytes"]):
        sys.exit("The copy on this Mac does not match the source. Nothing was copied.")
    if report["kind"] == "file":
        os.chmod(part, report["mode"] & 0o777)
        try:
            if force == "1" and os.path.lexists(target):
                os.replace(part, target)
            else:
                # A link fails when the target appeared meanwhile, so no file is overwritten.
                os.link(part, target)
                os.unlink(part)
        except FileExistsError:
            sys.exit(f"{target} exists. Use --force to replace it. Nothing was copied.")
        except OSError as error:
            sys.exit(f"{target} could not be written: {error.strerror}. Nothing was copied.")
        files = 1
    else:
        name = report["name"]
        staging = Path(tempfile.mkdtemp(prefix=".tokiwa-cp-", dir=target.parent))
        try:
            with tarfile.open(part, "r:") as archive:
                members = archive.getmembers()
                if len(members) > MAX_FILES:
                    sys.exit(f"The directory holds more than {MAX_FILES} entries. Nothing was copied.")
                for member in members:
                    if not within(name, member.name) or not link_within(name, member):
                        sys.exit(f"The directory holds an entry outside {name}, or a link out of it. Nothing was copied.")
                # The data filter refuses absolute names, links that leave the folder and device files,
                # and drops setuid, setgid and sticky bits (Python 3.12, PEP 706).
                archive.extractall(staging, filter="data")
            top = staging / name
            if top.is_symlink() or not top.is_dir():
                sys.exit(f"The stream does not hold a directory named {name}. Nothing was copied.")
            if os.path.lexists(target):
                sys.exit(f"{target} exists. A directory is never replaced. Nothing was copied.")
            os.rename(top, target)
        except (tarfile.TarError, OSError) as error:
            sys.exit(f"The directory could not be unpacked: {error}. Nothing was copied.")
        finally:
            shutil.rmtree(staging, ignore_errors=True)
        os.unlink(part)
        files = len(members)
    print(json.dumps({"path": str(target), "kind": report["kind"], "files": files, "bytes": size, "sha256": sha256}))

step = sys.argv[1]
{"allowed": allowed, "check": check, "stream": stream, "prepare": prepare, "place": place}[step](*sys.argv[2:])
PY_CP
  quote() { python3 -I -c 'import shlex,sys; print(" ".join(shlex.quote(x) for x in sys.argv[1:]))' "$@"; }
  field() { python3 -I -c 'import json,sys; print(json.loads(sys.argv[1])[sys.argv[2]])' "$1" "$2"; }
  cp_refused() {
   local errors refusal
   errors=$(aws_call ssm get-command-invocation --command-id "$id" --instance-id "$instance" --query StandardErrorContent --output text) || errors=
   refusal=$(printf '%s\n' "$errors" | sed -E '/^[[:space:]]*$/d; /^failed to run commands: exit status [0-9]+$/d' | tail -n 1)
   fail "${refusal:-The copy returned $status. Nothing was copied.}"
  }
  # The bucket keeps versions; the cleanup deletes the uploaded version by its id when it has one.
  cp_version() { paste_version=$(aws_call s3api head-object --bucket "$paste_bucket" --key "$paste_key" --query VersionId --output text 2>/dev/null) || paste_version=; }
  work=$(umask 077; mktemp -d "${TMPDIR:-/tmp}/tokiwa-cp.XXXXXX") || fail 'A copy needs a temporary folder. Nothing was copied.'
  cp_id=$(python3 -c 'import secrets; print(secrets.token_hex(16))')
  pipe=/opt/agent-platform/rootless/tokiwa-s3-pipe.py
  ready='systemctl is-active --quiet cloud-workbench.service user@2200.service'
  # An agent through the MCP server reaches only the folders that the owner listed on this Mac; a
  # person at the command line or in the app reaches every folder.
  if [[ $via == mcp ]]; then
   python3 -I -c "$cp_program" allowed "$cp_local" "$cp_direction" "$HOME/.config/tokiwa/transfer-dirs" "$HOME/Tokiwa/transfers" || exit 1
  fi
  if [[ $cp_direction == up ]]; then
   facts=$(python3 -I -c "$cp_program" check "$cp_local") || exit 1
   paste_key=inputs/transfers/$cp_id
   python3 -I -c "$cp_program" stream "$cp_local" "$facts" "$work/sent.json" | aws_call s3 cp - "s3://$paste_bucket/$paste_key" --only-show-errors \
    || fail 'The upload to S3 failed. Nothing was copied.'
   cp_version
   sent=$(<"$work/sent.json")
   cp_bytes=$(field "$sent" bytes) cp_sha=$(field "$sent" sha256)
   args=$(quote "$cp_remote" "$(field "$facts" kind)" "$(field "$facts" name)" "$cp_sha" "$cp_bytes" \
    "$(printf '%03o' "$(field "$facts" mode)")" "$cp_force")
   remote="$ready && python3 -I $pipe get $region $paste_bucket $paste_key -- $helper transfer-in $args"
   # The copy from S3 to the host runs at tens of MB/s; the slow leg, from this Mac, is already done.
   exec_timeout=$(( 120 + cp_bytes / 20000000 ))
  else
   paste_key=results/transfers/$cp_id
   remote="$ready && python3 -I $pipe put $region $paste_bucket $paste_key -- $helper transfer-out $(quote "$cp_remote")"
   # The size is known only on the host; this covers 10 GB at about 6 MB/s.
   exec_timeout=1800
  fi
  tries=$(( exec_timeout + 15 ))
  submit "$remote"
  [[ $cp_direction == up ]] || cp_version
  [[ $status == Success ]] || cp_refused
  result=$(aws_call ssm get-command-invocation --command-id "$id" --instance-id "$instance" --query StandardOutputContent --output text) \
   || fail 'The copy result could not be read.'
  if [[ $cp_direction == up ]]; then
   [[ $(field "$result" sha256) == "$cp_sha" ]] || fail 'The host reported a different SHA-256. Check the target on the host.'
  else
   placed=$(python3 -I -c "$cp_program" prepare "$result" "$cp_local" "$cp_force") || exit 1
   cp_part=${placed%%$'\n'*}
   cp_target=${placed#*$'\n'}
   aws_call s3 cp "s3://$paste_bucket/$paste_key" "$cp_part" --only-show-errors || fail 'The download from S3 failed. Nothing was copied.'
   result=$(python3 -I -c "$cp_program" place "$result" "$cp_target" "$cp_part" "$cp_force") || exit 1
  fi
  if [[ $cp_json == 1 ]]; then printf '%s\n' "$result"
  else
   python3 -c 'import json,sys; r=json.loads(sys.argv[1]); n=r["files"]; print("Copied %d %s, %d bytes, to %s%s (sha256 %s)." % (n, "file" if n == 1 else "entries", r["bytes"], "host:" if sys.argv[2] == "up" else "", r["path"], r["sha256"][:12]))' "$result" "$cp_direction"
  fi
  exit 0
 fi
 # The host certificate that message text is encrypted to. Only the certificate is public; the key
 # stays on the host (see host/tokiwa-input.py). This reads it from the host in one Run Command call.
 # A host from before encrypted input has no certificate: the launcher stops there, and never sends the
 # text in plain form.
 host_cert() {
  local cert nothing='Nothing was sent.'
  [[ $mode != create ]] || nothing='Nothing was created.'
  [[ $mode != input-cert ]] || nothing='Nothing was read.'
  submit 'if [ -e /etc/tokiwa/input-cert.pem ]; then cat /etc/tokiwa/input-cert.pem; else echo tokiwa-no-input-key; fi'
  [[ $status == Success ]] || fail 'The host input certificate could not be read.'
  cert=$(aws_call ssm get-command-invocation --command-id "$id" --instance-id "$instance" --query StandardOutputContent --output text) \
   || fail 'The host input certificate could not be read.'
  [[ $cert != tokiwa-no-input-key ]] || fail "The host has no input key. Update the host with host/install.sh. $nothing"
  printf '%s\n' "$cert"
 }
 # Encrypt the file $1 to the pinned host certificate and print it as one line of base64 DER. The
 # first use pins the certificate that the host shows; later calls never fetch it again, so a key
 # that changes on the host is refused by the host and not trusted by this launcher.
 input_pin=$HOME/.config/tokiwa/input-cert.pem
 seal_input() {
  command -v openssl >/dev/null || fail 'A message needs openssl.'
  if [[ ! -s $input_pin ]]; then
   local cert pinned
   cert=$(host_cert) || exit 1
   printf '%s\n' "$cert" | openssl x509 -noout >/dev/null 2>&1 || fail 'The host input certificate is not valid. Nothing was sent.'
   mkdir -p "$(dirname "$input_pin")"
   pinned=$(umask 022; mktemp "$input_pin.XXXXXX") || fail 'The host input certificate could not be saved.'
   printf '%s\n' "$cert" > "$pinned" && mv "$pinned" "$input_pin" || fail 'The host input certificate could not be saved.'
  fi
  openssl x509 -in "$input_pin" -noout >/dev/null 2>&1 \
   || fail 'The pinned host input certificate is not valid. Delete ~/.config/tokiwa/input-cert.pem to pin the host key again.'
  # The marker line lets the host tell the text from the garbage that a wrong key can produce.
  ( set -o pipefail; { printf 'tokiwa-input-v1\n'; cat "$1"; } | openssl smime -encrypt -aes256 -binary -outform DER "$input_pin" | base64 | tr -d '\n' ) \
   || fail 'The message could not be encrypted. Nothing was sent.'
 }
 if [[ $mode == input-cert ]]; then host_cert; exit 0; fi
 if [[ $mode == paste-image ]]; then
  # The image goes to the bucket, and only a presigned URL that lives 5 minutes goes to the host. The
  # URL is written by builtins and redirections only, in a private folder, and travels sealed.
  paste_key=inputs/clipboard/$(python3 -c 'import secrets; print(secrets.token_hex(16))').png
  input_dir=$(umask 077; mktemp -d "${TMPDIR:-/tmp}/tokiwa-input.XXXXXX") || fail 'An image paste needs a temporary folder. Nothing was pasted.'
  input_file=$input_dir/url
  paste_version=$(aws_call s3api put-object --bucket "$paste_bucket" --key "$paste_key" --body "$paste_file" --query VersionId --output text) || fail 'The image could not be uploaded. Nothing was pasted.'
  paste_url=$(aws_call s3 presign "s3://$paste_bucket/$paste_key" --expires-in 300) || fail 'The image link could not be made. Nothing was pasted.'
  printf '%s' "$paste_url" > "$input_file"
  unset paste_url
 fi
 if [[ ( $mode == create || $mode == agent-send || $mode == agent-answer || $mode == paste-image ) && -n $input_file ]]; then
  # Run Command runs as root. Root decrypts the line and pipes it to the helper, which reads it
  # from stdin: the text is never an argument, a file or output on the host.
  sealed_line=$(seal_input "$input_file") || exit 1
  inner="set -o pipefail; python3 -I /opt/agent-platform/rootless/tokiwa-input.py $sealed_line | $helper $mode $quoted"
